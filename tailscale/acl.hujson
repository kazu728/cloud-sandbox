{
	"tagOwners": {
		"tag:homelab":       ["autogroup:admin"],
		"tag:cloud-sandbox": ["autogroup:admin"],
	},

	"grants": [
		{
			"src": ["tag:cloud-sandbox"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		{
			"src": ["kazuki.matsuo.728@gmail.com"],
			"dst": ["tag:cloud-sandbox"],
			"ip":  ["tcp:22", "tcp:30300"],
		},
		{
			"src": ["kazuki.matsuo.728@gmail.com"],
			"dst": ["tag:homelab"],
			"ip":  ["tcp:22", "tcp:443", "tcp:6443", "tcp:8443"],
		},
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["kazuki.matsuo.728@gmail.com"],
			"dst":    ["tag:cloud-sandbox"],
			"users":  ["root"],
		},
	],

	"sshTests": [
		{
			"src":    "kazuki.matsuo.728@gmail.com",
			"dst":    ["tag:cloud-sandbox"],
			"accept": ["root"],
			"deny":   ["autogroup:nonroot"],
		},
		{
			"src":  "tag:cloud-sandbox",
			"dst":  ["tag:cloud-sandbox"],
			"deny": ["root"],
		},
		{
			"src":  "tag:homelab",
			"dst":  ["tag:cloud-sandbox"],
			"deny": ["root"],
		},
	],

	"tests": [
		{
			"src":    "kazuki.matsuo.728@gmail.com",
			"accept": ["tag:cloud-sandbox:22", "tag:cloud-sandbox:30300"],
			"deny":   ["tag:cloud-sandbox:80", "tag:cloud-sandbox:443"],
		},
		{
			"src":  "tag:cloud-sandbox",
			"deny": ["kazuki.matsuo.728@gmail.com:22"],
		},
		{
			"src":    "kazuki.matsuo.728@gmail.com",
			"accept": ["tag:homelab:22", "tag:homelab:443", "tag:homelab:6443", "tag:homelab:8443"],
			"deny":   ["tag:homelab:80"],
		},
		{
			"src":  "tag:homelab",
			"deny": ["kazuki.matsuo.728@gmail.com:22"],
		},
	],
}
